{
  "name": "sprite-character-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Terrarium — the scenario seed authoring studio for The Water Cooler (employees, office, and starting social conditions). Package name kept as sprite-character-creator for compatibility.",
  "scripts": {
    "dev": "npm run assets:check && vite",
    "build": "npm run assets:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/runTestsSafely.ts",
    "test:update": "tsx scripts/runTestsSafely.ts --update",
    "export": "npm run assets:check && tsx scripts/export.ts",
    "export:quota-co-walls": "npm run assets:check && tsx scripts/export.ts --quota-co-wall-evaluation",
    "parts:import": "tsx scripts/importParts.ts",
    "parts:import:check": "tsx scripts/importParts.ts --check",
    "parts:scaffolds": "tsx scripts/generatePartScaffolds.ts",
    "parts:scaffolds:check": "tsx scripts/generatePartScaffolds.ts --check",
    "parts:check": "npm run parts:import:check && npm run parts:scaffolds:check",
    "walls:import": "tsx scripts/importWallBevel.ts",
    "walls:import:check": "tsx scripts/importWallBevel.ts --check",
    "walls:preview": "tsx scripts/wallBevelPreview.ts",
    "walls:materials:preview": "tsx scripts/wallTilesetPreview.ts",
    "high-oblique:a1a:preview": "tsx scripts/quotaCoHighObliqueA1aPreview.ts",
    "high-oblique:a1b:preview": "tsx scripts/quotaCoHighObliqueA1bPreview.ts",
    "high-oblique:a1b:topology:preview": "tsx scripts/quotaCoHighObliqueA1bTopologyPreview.ts",
    "high-oblique:a1b:low-profile:preview": "tsx scripts/quotaCoHighObliqueA1bLowProfilePreview.ts",
    "high-oblique:footprint:preview": "tsx scripts/quotaCoEqualHeightFootprintCalibrationPreview.ts",
    "high-oblique:footprint:all47:preview": "tsx scripts/quotaCoEqualHeightFootprintAllMaskPreview.ts",
    "style:watch": "tsx scripts/styleLoop.ts",
    "style:once": "tsx scripts/styleLoop.ts --once",
    "style:consistency": "tsx scripts/styleLoop.ts --consistency",
    "style:serve": "tsx scripts/styleLoop.ts --serve-only",
    "iris:preview": "tsx scripts/irisFamilyPreview.ts",
    "flora:preview": "tsx scripts/floraFieldPreview.ts",
    "assets:check": "npm run parts:check && npm run walls:import:check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.9.3",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "svgo": "^4.0.1",
    "svgpath": "^2.6.0",
    "svgson": "^5.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
