{
  "name": "sprite-character-creator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Terrarium — the scenario seed authoring studio for The Water Cooler (employees, office, and starting social conditions). Package name kept as sprite-character-creator for compatibility.",
  "scripts": {
    "dev": "npm run assets:check && vite",
    "build": "npm run assets:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/runTestsSafely.ts",
    "test:update": "tsx scripts/runTestsSafely.ts --update",
    "export": "npm run assets:check && tsx scripts/export.ts",
    "parts:import": "tsx scripts/importParts.ts",
    "parts:import:check": "tsx scripts/importParts.ts --check",
    "parts:scaffolds": "tsx scripts/generatePartScaffolds.ts",
    "parts:scaffolds:check": "tsx scripts/generatePartScaffolds.ts --check",
    "parts:check": "npm run parts:import:check && npm run parts:scaffolds:check",
    "hair:canonical-bob:production-preview": "tsx scripts/canonicalBobSourceFitProof.ts",
    "hair:canonical-short:production-preview": "tsx scripts/canonicalShortSourceFitProof.ts",
    "hair:canonical-bun:production-preview": "tsx scripts/canonicalBunSourceFitProof.ts",
    "hair:canonical-ponytail:production-preview": "tsx scripts/canonicalPonytailSourceFitProof.ts",
    "hair:canonical-long-straight:production-preview": "tsx scripts/canonicalLongStraightSourceFitProof.ts",
    "props:import": "tsx scripts/importQuotaCoWorkhorseProps.ts",
    "props:import:check": "tsx scripts/importQuotaCoWorkhorseProps.ts --check",
    "department-machines:import": "tsx scripts/importQuotaCoDepartmentMachines.ts --write",
    "department-machines:import:check": "tsx scripts/importQuotaCoDepartmentMachines.ts --check",
    "department-machines:production:preview": "tsx scripts/quotaCoDepartmentMachineProductionValidationPreview.ts",
    "department-machines:farm-p1:preview": "tsx scripts/quotaCoDepartmentFarmFormPriorityOneCalibrationPreview.ts",
    "department-machines:farm-p2:preview": "tsx scripts/quotaCoDepartmentFarmFormPriorityTwoCalibrationPreview.ts",
    "department-machines:partition-replacement:preview": "tsx scripts/quotaCoCubiclePartitionReplacementCalibrationPreview.ts",
    "department-machines:motion:preview": "tsx scripts/quotaCoDepartmentMachineMotionCalibrationPreview.ts",
    "department-machines:priority2:preview": "tsx scripts/quotaCoDepartmentMachinePhaseASpineCalibrationPreview.ts",
    "department-machines:priority3a:preview": "tsx scripts/quotaCoDepartmentMachineEngineeringMaintenanceCalibrationPreview.ts",
    "surfaces:import": "tsx scripts/importQuotaCoMaintainedHybridSurfaces.ts",
    "surfaces:import:check": "tsx scripts/importQuotaCoMaintainedHybridSurfaces.ts --check",
    "surfaces:production:preview": "tsx scripts/quotaCoFloorGrassProductionValidationPreview.ts",
    "assets:reference:guide": "tsx scripts/canonicalSvgReferenceGuide.ts",
    "assets:reference:guide:check": "tsx scripts/canonicalSvgReferenceGuide.ts --check",
    "props:production:preview": "tsx scripts/quotaCoPropProductionValidationPreview.ts",
    "props:canonical-portfolio:preview": "tsx scripts/quotaCoCanonicalPropPortfolioPreview.ts",
    "props:workstation:production:preview": "tsx scripts/quotaCoWorkstationFamilyProductionValidationPreview.ts",
    "props:service-machines:preview": "tsx scripts/quotaCoServiceMachineFamilyCalibrationPreview.ts",
    "props:service-machines:production:preview": "tsx scripts/quotaCoServiceMachineFamilyProductionValidationPreview.ts",
    "props:social-furniture:preview": "tsx scripts/quotaCoSocialFurnitureFamilyCalibrationPreview.ts",
    "props:social-furniture:production-preview": "tsx scripts/quotaCoSocialFurnitureFamilyProductionValidationPreview.ts",
    "props:storage-support:preview": "tsx scripts/quotaCoStorageSupportFamilyCalibrationPreview.ts",
    "props:storage-support:production-preview": "tsx scripts/quotaCoStorageSupportFamilyProductionValidationPreview.ts",
    "props:decor-personalization:preview": "tsx scripts/quotaCoDecorPersonalizationFamilyCalibrationPreview.ts",
    "props:decor-personalization:production-preview": "tsx scripts/quotaCoDecorPersonalizationFamilyProductionValidationPreview.ts",
    "walls:import": "tsx scripts/importWallBevel.ts && tsx scripts/importQuotaCoEqualHeightWall.ts",
    "walls:import:check": "tsx scripts/importWallBevel.ts --check && tsx scripts/importQuotaCoEqualHeightWall.ts --check",
    "walls:preview": "tsx scripts/wallBevelPreview.ts",
    "walls:materials:preview": "tsx scripts/wallTilesetPreview.ts",
    "high-oblique:a1a:preview": "tsx scripts/quotaCoHighObliqueA1aPreview.ts",
    "high-oblique:a1b:preview": "tsx scripts/quotaCoHighObliqueA1bPreview.ts",
    "high-oblique:a1b:topology:preview": "tsx scripts/quotaCoHighObliqueA1bTopologyPreview.ts",
    "high-oblique:a1b:low-profile:preview": "tsx scripts/quotaCoHighObliqueA1bLowProfilePreview.ts",
    "high-oblique:footprint:preview": "tsx scripts/quotaCoEqualHeightFootprintCalibrationPreview.ts",
    "high-oblique:footprint:all47:preview": "tsx scripts/quotaCoEqualHeightFootprintAllMaskPreview.ts",
    "high-oblique:footprint:sources:check": "tsx scripts/promoteQuotaCoEqualHeightFootprint.ts --check",
    "high-oblique:footprint:sources:write": "tsx scripts/promoteQuotaCoEqualHeightFootprint.ts --write",
    "high-oblique:path-locks:check": "tsx scripts/reconcileEqualHeightProposalPathLocks.ts --check",
    "high-oblique:path-locks:write": "tsx scripts/reconcileEqualHeightProposalPathLocks.ts --write",
    "style:watch": "tsx scripts/styleLoop.ts",
    "style:once": "tsx scripts/styleLoop.ts --once",
    "style:consistency": "tsx scripts/styleLoop.ts --consistency",
    "style:serve": "tsx scripts/styleLoop.ts --serve-only",
    "iris:preview": "tsx scripts/irisFamilyPreview.ts",
    "flora:preview": "tsx scripts/floraFieldPreview.ts",
    "assets:check": "npm run parts:check && npm run props:import:check && npm run department-machines:import:check && npm run surfaces:import:check && npm run walls:import:check"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^25.9.3",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "svgo": "^4.0.1",
    "svgpath": "^2.6.0",
    "svgson": "^5.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
